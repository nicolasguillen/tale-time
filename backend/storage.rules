rules_version = '2';

// Tale Time's content host (plan.md §7.3), bucket tale-time-b537d.firebasestorage.app.
// The app only downloads: the catalog and the story packages under stories/. Single files can be read by anyone,
// but nobody can list the bucket or write through the API. `story publish` uploads with the owner's own
// credentials (gcloud or the Admin SDK), which these rules don't apply to.
service firebase.storage {
  match /b/{bucket}/o {
    match /stories/{path=**} {
      allow get;
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
