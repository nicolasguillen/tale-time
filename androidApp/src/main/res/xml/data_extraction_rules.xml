<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: the downloaded stories stay out of cloud backups and device transfers; they download again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="library/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="library/" />
    </device-transfer>
</data-extraction-rules>
