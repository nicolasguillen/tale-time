.DS_Store
.idea/

# Python (tools/)
__pycache__/
.venv/
.pytest_cache/
*.egg-info/

# Work-in-progress content that never gets committed
content/.work/
# Delivered originals (pictures, reference sheets, style anchors, narration clips, the app icon): too heavy for git.
# They're kept in Firebase Storage (originals/) and listed in content/originals.json: `story originals push` / `pull`.
content/**/*.webp
content/**/*.png
content/**/*.jpg
content/**/*.jpeg
content/**/*.wav
content/**/*.flac
content/**/*.m4a
# What `story package` builds (the draft and production channels) and its cache of converted files
content/.build/

# App (Gradle, Kotlin, Xcode)
*.iml
.kotlin/
.gradle/
**/build/
!src/**/build/
local.properties
xcuserdata/
captures/
.externalNativeBuild/
.cxx/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings

# Firebase CLI
.firebase/
*-debug.log
